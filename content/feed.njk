---
# RSS 2.0 + Media RSS — generated from the news collection
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ site.name }} — Noticias</title>
    <link>{{ site.url }}news/</link>
    <description>{{ site.description }}</description>
    <language>es</language>
    <copyright>© {{ site.year }} {{ site.name }}</copyright>
    <managingEditor>{{ site.email }} ({{ site.name }})</managingEditor>
    {% if collections.news.length %}<lastBuildDate>{{ collections.news[0].data.pubDate | rfc }}</lastBuildDate>{% endif %}
    <atom:link href="{{ site.domain }}{{ site.rss }}" rel="self" type="application/rss+xml"/>
    <atom:link href="{{ site.url }}news/" rel="alternate" type="text/html"/>
    <image>
      <url>{{ site.domain }}{{ site.ogImage }}</url>
      <title>{{ site.name }}</title>
      <link>{{ site.url }}news/</link>
    </image>
    {% for item in collections.news %}{% if not item.data.noindex %}
    {% set creator = site.name %}{% if item.data.author and item.data.author.name %}{% set creator = item.data.author.name %}{% elif item.data.author %}{% set creator = item.data.author %}{% endif %}
    <item>
      <title>{{ item.data.title }}</title>
      <link>{{ item.data.canonical }}</link>
      <guid isPermaLink="true">{{ item.data.canonical }}</guid>
      <pubDate>{{ item.data.pubDate | rfc }}</pubDate>
      <dc:creator>{{ creator }}</dc:creator>
      <description>{{ item.data.description }}</description>
      <content:encoded><![CDATA[{{ item.templateContent | safe }}]]></content:encoded>
      <language>{{ item.data.lang }}</language>
      {% for t in item.data.tags %}<category>{{ t }}</category>
      {% endfor %}
      {% if item.data.image %}<media:content url="{{ item.data.image.src | abs }}" width="{{ item.data.image.width }}" height="{{ item.data.image.height }}" type="{{ item.data.image.type }}" medium="image">
        <media:title>{{ item.data.image.alt }}</media:title>
        <media:description>{{ item.data.image.alt }}</media:description>
      </media:content>
      <media:thumbnail url="{{ item.data.image.src | abs }}"/>{% endif %}
    </item>
    {% endif %}{% endfor %}
  </channel>
</rss>
