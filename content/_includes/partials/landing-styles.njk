            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }
            * {
                margin: 0;
            }

            :root {
                --bg: #0a0a14;
                --surface: #11111d;
                --surface-2: #161628;
                --border: #22223a;
                --fg: #e8e8f0;
                --fg-muted: #8a8aa8;
                --fg-dim: #5a5a78;
                --accent: #8b5cf6;
                --accent-2: #ec4899;
                --accent-3: #22d3ee;
                --glow:
                    radial-gradient(
                        60% 80% at 20% 0%,
                        rgba(139, 92, 246, 0.18),
                        transparent 60%
                    ),
                    radial-gradient(
                        50% 60% at 90% 20%,
                        rgba(34, 211, 238, 0.1),
                        transparent 60%
                    );
                --radius: 14px;
                --radius-lg: 22px;
                --maxw: 1120px;
                --t: 180ms cubic-bezier(0.2, 0.7, 0.2, 1);
            }
            @media (prefers-color-scheme: light) {
                :root:not([data-theme="dark"]) {
                    --bg: #fafafc;
                    --surface: #ffffff;
                    --surface-2: #f3f3f8;
                    --border: #e4e4ee;
                    --fg: #0a0a14;
                    --fg-muted: #5a5a78;
                    --fg-dim: #8a8aa8;
                    --glow:
                        radial-gradient(
                            60% 80% at 20% 0%,
                            rgba(139, 92, 246, 0.1),
                            transparent 60%
                        ),
                        radial-gradient(
                            50% 60% at 90% 20%,
                            rgba(34, 211, 238, 0.06),
                            transparent 60%
                        );
                }
            }
            :root[data-theme="light"] {
                --bg: #fafafc;
                --surface: #ffffff;
                --surface-2: #f3f3f8;
                --border: #e4e4ee;
                --fg: #0a0a14;
                --fg-muted: #5a5a78;
                --fg-dim: #8a8aa8;
                --glow:
                    radial-gradient(
                        60% 80% at 20% 0%,
                        rgba(139, 92, 246, 0.1),
                        transparent 60%
                    ),
                    radial-gradient(
                        50% 60% at 90% 20%,
                        rgba(34, 211, 238, 0.06),
                        transparent 60%
                    );
            }
            :root[data-theme="dark"] {
                --bg: #0a0a14;
                --surface: #11111d;
                --surface-2: #161628;
                --border: #22223a;
                --fg: #e8e8f0;
                --fg-muted: #8a8aa8;
                --fg-dim: #5a5a78;
                --glow:
                    radial-gradient(
                        60% 80% at 20% 0%,
                        rgba(139, 92, 246, 0.18),
                        transparent 60%
                    ),
                    radial-gradient(
                        50% 60% at 90% 20%,
                        rgba(34, 211, 238, 0.1),
                        transparent 60%
                    );
            }

            html {
                color-scheme: light dark;
                background: var(--bg);
            }
            body {
                background: var(--bg);
                color: var(--fg);
                font-family:
                    -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                    "Helvetica Neue", Arial, sans-serif;
                font-size: 16px;
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                text-rendering: optimizeLegibility;
                min-height: 100dvh;
                background-image: var(--glow);
                background-attachment: fixed;
            }
            img,
            svg {
                max-width: 100%;
                display: block;
                height: auto;
            }
            a {
                color: var(--accent);
                text-decoration: none;
                transition: color var(--t);
            }
            a:hover {
                color: var(--accent-2);
            }
            :focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 3px;
                border-radius: 4px;
            }
            button {
                font: inherit;
                cursor: pointer;
                border: 0;
                background: none;
                color: inherit;
            }
            ::selection {
                background: var(--accent);
                color: #fff;
            }

            .skip {
                position: absolute;
                left: -9999px;
                top: 0;
                background: var(--accent);
                color: #fff;
                padding: 0.75rem 1rem;
                border-radius: 0 0 var(--radius) 0;
                z-index: 1000;
                font-weight: 600;
            }
            .skip:focus {
                left: 0;
            }

            .wrap {
                max-width: var(--maxw);
                margin: 0 auto;
                padding: 0 1.25rem;
            }

            header {
                position: sticky;
                top: 0;
                z-index: 50;
                backdrop-filter: saturate(180%) blur(14px);
                -webkit-backdrop-filter: saturate(180%) blur(14px);
                background: color-mix(in srgb, var(--bg) 75%, transparent);
                border-bottom: 1px solid var(--border);
            }
            .nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                height: 64px;
                gap: 1rem;
            }
            .brand {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                font-weight: 700;
                letter-spacing: -0.01em;
                color: var(--fg);
            }
            .brand-mark {
                width: 28px;
                height: 28px;
            }
            .nav-links {
                display: none;
                gap: 1.75rem;
            }
            .nav-links a {
                color: var(--fg-muted);
                font-size: 0.92rem;
                font-weight: 500;
            }
            .nav-links a:hover {
                color: var(--fg);
            }
            .nav-actions {
                display: flex;
                align-items: center;
                gap: 0.4rem;
            }
            .icon-btn {
                width: 38px;
                height: 38px;
                display: grid;
                place-items: center;
                border-radius: 10px;
                color: var(--fg-muted);
                transition: all var(--t);
            }
            .icon-btn:hover {
                background: var(--surface-2);
                color: var(--fg);
            }
            .icon-btn svg {
                width: 18px;
                height: 18px;
            }

            @media (min-width: 760px) {
                .nav-links {
                    display: flex;
                }
            }

            .btn {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.7rem 1.1rem;
                border-radius: 999px;
                font-weight: 600;
                font-size: 0.95rem;
                transition: all var(--t);
                white-space: nowrap;
            }
            .btn-primary {
                background: var(--fg);
                color: var(--bg);
            }
            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 8px 24px -8px var(--accent);
            }
            .btn-ghost {
                border: 1px solid var(--border);
                color: var(--fg);
            }
            .btn-ghost:hover {
                background: var(--surface-2);
            }

            main {
                padding-bottom: 5rem;
            }
            section {
                padding: 4rem 0;
                scroll-margin-top: 80px;
            }
            section h2 {
                font-size: clamp(1.6rem, 3.6vw, 2.4rem);
                font-weight: 800;
                letter-spacing: -0.02em;
                line-height: 1.15;
                margin-bottom: 0.75rem;
            }
            section .lede {
                color: var(--fg-muted);
                font-size: 1.05rem;
                max-width: 60ch;
                margin-bottom: 2.5rem;
            }

            .eyebrow {
                display: inline-block;
                font-size: 0.78rem;
                font-weight: 600;
                letter-spacing: 0.12em;
                text-transform: uppercase;
                color: var(--accent);
                margin-bottom: 1rem;
            }

            .hero {
                padding: 5rem 0 3rem;
                position: relative;
            }
            .hero h1 {
                font-size: clamp(2.2rem, 6vw, 4.2rem);
                font-weight: 800;
                letter-spacing: -0.03em;
                line-height: 1.05;
                margin-bottom: 1.25rem;
                max-width: 18ch;
            }
            .hero h1 .grad {
                background: linear-gradient(
                    120deg,
                    var(--accent) 0%,
                    var(--accent-2) 50%,
                    var(--accent-3) 100%
                );
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }
            .hero p.lede {
                font-size: clamp(1.05rem, 1.6vw, 1.2rem);
                max-width: 55ch;
            }
            .hero-cta {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 2rem;
            }
            .hero-meta {
                display: flex;
                flex-wrap: wrap;
                gap: 1.5rem 2.5rem;
                margin-top: 3rem;
                padding-top: 2rem;
                border-top: 1px solid var(--border);
            }
            .hero-meta div {
                font-size: 0.9rem;
                color: var(--fg-muted);
            }
            .hero-meta strong {
                display: block;
                color: var(--fg);
                font-size: 1.4rem;
                font-weight: 700;
                letter-spacing: -0.02em;
                margin-bottom: 0.1rem;
            }

            .apps-head {
                display: flex;
                align-items: end;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
                margin-bottom: 2rem;
            }
            .apps-head p {
                margin: 0;
                color: var(--fg-muted);
            }
            .apps-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 1.25rem;
            }
            @media (min-width: 680px) {
                .apps-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
            @media (min-width: 1000px) {
                .apps-grid {
                    grid-template-columns: repeat(4, 1fr);
                }
            }

            .app-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 1.5rem;
                display: flex;
                flex-direction: column;
                gap: 1rem;
                transition: all var(--t);
                position: relative;
                overflow: hidden;
            }
            .app-card:hover {
                border-color: var(--accent);
                transform: translateY(-2px);
            }
            .app-card::before {
                content: "";
                position: absolute;
                inset: 0;
                background: radial-gradient(
                    80% 60% at 50% 0%,
                    var(--accent-glow, rgba(139, 92, 246, 0.15)),
                    transparent 70%
                );
                opacity: 0;
                transition: opacity var(--t);
                pointer-events: none;
            }
            .app-card:hover::before {
                opacity: 1;
            }
            .app-icon {
                width: 64px;
                height: 64px;
                border-radius: 16px;
                display: grid;
                place-items: center;
                background: linear-gradient(
                    135deg,
                    var(--c1, var(--accent)),
                    var(--c2, var(--accent-2))
                );
                color: #fff;
                font-weight: 800;
                font-size: 1.5rem;
                letter-spacing: -0.02em;
                box-shadow: 0 8px 24px -8px var(--c1, var(--accent));
            }
            .app-card h3 {
                font-size: 1.15rem;
                font-weight: 700;
                letter-spacing: -0.01em;
            }
            .app-card .cat {
                font-size: 0.78rem;
                color: var(--fg-muted);
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }
            .app-card .desc {
                color: var(--fg-muted);
                font-size: 0.92rem;
                flex: 1;
            }
            .app-badge {
                display: inline-flex;
                align-items: center;
                gap: 0.6rem;
                padding: 0.55rem 0.85rem;
                border-radius: 10px;
                background: #000;
                color: #fff;
                font-size: 0.82rem;
                font-weight: 500;
                align-self: flex-start;
                transition: transform var(--t);
            }
            .app-badge:hover {
                transform: scale(1.02);
                color: #fff;
            }
            .app-badge-soon {
                cursor: default;
            }
            .app-badge-soon:hover {
                transform: none;
                color: #fff;
            }
            .app-badge svg {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
            }
            .app-badge small {
                display: block;
                font-size: 0.65rem;
                opacity: 0.85;
                line-height: 1;
            }
            .app-badge strong {
                font-size: 0.85rem;
                font-weight: 500;
                letter-spacing: 0.01em;
            }

            .services-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 1.25rem;
            }
            @media (min-width: 680px) {
                .services-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
            @media (min-width: 1000px) {
                .services-grid {
                    grid-template-columns: repeat(3, 1fr);
                }
            }
            .service {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 1.5rem;
                transition: all var(--t);
            }
            .service:hover {
                border-color: var(--accent);
            }
            .service-icon {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                background: var(--surface-2);
                display: grid;
                place-items: center;
                color: var(--accent);
                margin-bottom: 1rem;
            }
            .service-icon svg {
                width: 20px;
                height: 20px;
            }
            .service h3 {
                font-size: 1.05rem;
                font-weight: 700;
                margin-bottom: 0.4rem;
                letter-spacing: -0.01em;
            }
            .service p {
                color: var(--fg-muted);
                font-size: 0.92rem;
            }

            .process {
                display: grid;
                grid-template-columns: 1fr;
                gap: 0;
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
            }
            @media (min-width: 680px) {
                .process {
                    grid-template-columns: repeat(5, 1fr);
                }
            }
            .step {
                padding: 1.5rem;
                border-bottom: 1px solid var(--border);
                position: relative;
            }
            @media (min-width: 680px) {
                .step {
                    border-bottom: 0;
                    border-right: 1px solid var(--border);
                }
                .step:last-child {
                    border-right: 0;
                }
            }
            .step:last-child {
                border-bottom: 0;
            }
            .step .n {
                font-size: 0.75rem;
                font-weight: 700;
                color: var(--accent);
                letter-spacing: 0.1em;
                margin-bottom: 0.5rem;
            }
            .step h4 {
                font-size: 1rem;
                font-weight: 700;
                margin-bottom: 0.3rem;
                letter-spacing: -0.01em;
            }
            .step p {
                color: var(--fg-muted);
                font-size: 0.88rem;
            }

            .blog-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 1.5rem;
            }
            @media (min-width: 680px) {
                .blog-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
            .blog-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 1.5rem;
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
                transition: all var(--t);
            }
            .blog-card:hover {
                border-color: var(--accent);
                transform: translateY(-2px);
            }
            .blog-card .cat {
                font-size: 0.78rem;
                color: var(--fg-muted);
                text-transform: uppercase;
                letter-spacing: 0.1em;
            }
            .blog-card h3 {
                font-size: 1.1rem;
                font-weight: 700;
                letter-spacing: -0.01em;
                line-height: 1.3;
            }
            .blog-card .excerpt {
                color: var(--fg-muted);
                font-size: 0.92rem;
                flex: 1;
            }
            .blog-card .date {
                color: var(--fg-dim);
                font-size: 0.82rem;
            }
            .blog-card .read-more {
                color: var(--accent);
                font-weight: 600;
                font-size: 0.88rem;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                margin-top: 0.25rem;
            }
            .blog-card .read-more:hover {
                color: var(--accent-2);
                gap: 0.6rem;
            }
            .blog-cta {
                margin-top: 2rem;
            }
            .novedades-cta {
                display: flex;
                flex-wrap: wrap;
                gap: 0.75rem;
                margin-top: 2rem;
            }

            .about-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 2.5rem;
                align-items: center;
            }
            @media (min-width: 880px) {
                .about-grid {
                    grid-template-columns: 1.1fr 1fr;
                }
            }
            .about-stats {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem;
                margin-top: 2rem;
            }
            .stat {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 1.25rem;
            }
            .stat .v {
                font-size: 1.8rem;
                font-weight: 800;
                letter-spacing: -0.02em;
                background: linear-gradient(
                    120deg,
                    var(--accent),
                    var(--accent-3)
                );
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }
            .stat .l {
                font-size: 0.82rem;
                color: var(--fg-muted);
                margin-top: 0.2rem;
            }
            .orb {
                aspect-ratio: 1;
                border-radius: 50%;
                position: relative;
                overflow: hidden;
                background: radial-gradient(
                    circle at 30% 30%,
                    #fff 0%,
                    #c4b5fd 10%,
                    #8b5cf6 35%,
                    #4c1d95 70%,
                    #1e1b4b 100%
                );
                box-shadow:
                    0 30px 80px -20px rgba(139, 92, 246, 0.5),
                    inset 0 0 80px rgba(0, 0, 0, 0.3);
                max-width: 380px;
                margin: 0 auto;
            }
            .orb::after {
                content: "";
                position: absolute;
                inset: -20%;
                border-radius: 50%;
                background: conic-gradient(
                    from 0deg,
                    transparent 0deg,
                    rgba(236, 72, 153, 0.3) 60deg,
                    transparent 120deg,
                    rgba(34, 211, 238, 0.2) 200deg,
                    transparent 280deg
                );
                filter: blur(20px);
                animation: spin 30s linear infinite;
            }
            @keyframes spin {
                to {
                    transform: rotate(360deg);
                }
            }
            @media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    animation-duration: 0.01ms !important;
                    transition-duration: 0.01ms !important;
                }
                .orb::after {
                    animation: none;
                }
            }

            .contact {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 2.5rem;
                margin-top: 2rem;
            }
            @media (min-width: 680px) {
                .contact {
                    padding: 3.5rem;
                }
            }
            .contact-form {
                display: grid;
                grid-template-columns: 1fr;
                gap: 1.25rem;
                max-width: 640px;
            }
            @media (min-width: 680px) {
                .contact-form {
                    grid-template-columns: repeat(2, 1fr);
                }
                .contact-form .full {
                    grid-column: 1/-1;
                }
            }
            .field {
                display: flex;
                flex-direction: column;
                gap: 0.4rem;
            }
            .field label {
                font-size: 0.85rem;
                font-weight: 600;
                color: var(--fg-muted);
            }
            .field input,
            .field textarea,
            .field select {
                background: var(--bg);
                color: var(--fg);
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 0.75rem 0.9rem;
                font: inherit;
                transition: all var(--t);
            }
            .field input:focus,
            .field textarea:focus,
            .field select:focus {
                outline: none;
                border-color: var(--accent);
                box-shadow: 0 0 0 3px
                    color-mix(in srgb, var(--accent) 20%, transparent);
            }
            .field textarea {
                resize: vertical;
                min-height: 120px;
            }
            .field .hint {
                font-size: 0.78rem;
                color: var(--fg-dim);
            }
            .contact-form button[type="submit"] {
                justify-self: start;
                margin-top: 0.5rem;
            }
            .form-note {
                font-size: 0.82rem;
                color: var(--fg-dim);
                margin-top: 1rem;
                max-width: 60ch;
            }

            footer {
                padding: 3rem 0 2rem;
                border-top: 1px solid var(--border);
                margin-top: 2rem;
                color: var(--fg-muted);
                font-size: 0.9rem;
            }
            .foot {
                display: flex;
                flex-wrap: wrap;
                gap: 1.5rem;
                justify-content: space-between;
                align-items: center;
            }
            .foot-links {
                display: flex;
                gap: 1.5rem;
                flex-wrap: wrap;
            }
            .foot-links a {
                color: var(--fg-muted);
            }
            .foot-links a:hover {
                color: var(--fg);
            }

            html[lang="es"] [lang="en"] {
                display: none !important;
            }
            html[lang="en"] [lang="es"] {
                display: none !important;
            }
        
