        *, *::before, *::after { box-sizing: border-box; }
        * { margin: 0; }
        :root {
            --bg: #0a0a14; --surface: #11111d; --surface-2: #161628;
            --border: #22223a; --fg: #e8e8f0; --fg-muted: #8a8aa8; --fg-dim: #5a5a78;
            --accent: #8b5cf6; --accent-2: #ec4899; --accent-3: #22d3ee;
            --radius: 14px; --radius-lg: 22px; --maxw: 1120px;
            --t: 180ms cubic-bezier(.2, .7, .2, 1);
        }
        @media (prefers-color-scheme: light) {
            :root:not([data-theme="dark"]) {
                --bg: #fafafc; --surface: #ffffff; --surface-2: #f3f3f8;
                --border: #e4e4ee; --fg: #0a0a14; --fg-muted: #5a5a78; --fg-dim: #8a8aa8;
            }
        }
        :root[data-theme="light"] {
            --bg: #fafafc; --surface: #ffffff; --surface-2: #f3f3f8;
            --border: #e4e4ee; --fg: #0a0a14; --fg-muted: #5a5a78; --fg-dim: #8a8aa8;
        }
        html { color-scheme: light dark; background: var(--bg); }
        body {
            background: var(--bg); color: var(--fg);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 16px; line-height: 1.65; min-height: 100dvh;
            -webkit-font-smoothing: antialiased;
        }
        img, svg, video { max-width: 100%; display: block; height: auto; }
        a { color: var(--accent); text-decoration: none; transition: color var(--t); }
        a:hover { color: var(--accent-2); }
        :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
        button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
        ::selection { background: var(--accent); color: #fff; }
        .skip { position: absolute; left: -9999px; background: var(--accent); color: #fff; padding: .75rem 1rem; border-radius: 0 0 var(--radius) 0; z-index: 1000; font-weight: 600; }
        .skip:focus { left: 0; }
        .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 1.25rem; }

        header { position: sticky; top: 0; z-index: 50; backdrop-filter: saturate(180%) blur(14px);
            background: color-mix(in srgb, var(--bg) 75%, transparent); border-bottom: 1px solid var(--border); }
        .nav { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 1rem; }
        .brand { display: flex; align-items: center; gap: .6rem; font-weight: 700; color: var(--fg); }
        .brand-mark { width: 28px; height: 28px; }
        .nav-links { display: none; gap: 1.5rem; }
        .nav-links a { color: var(--fg-muted); font-size: .92rem; font-weight: 500; }
        .nav-links a:hover, .nav-links a.current { color: var(--fg); }
        .nav-actions { display: flex; gap: .4rem; }
        .icon-btn { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; color: var(--fg-muted); }
        .icon-btn:hover { background: var(--surface-2); color: var(--fg); }
        .icon-btn svg { width: 18px; height: 18px; }
        @media (min-width: 760px) { .nav-links { display: flex; } }

        main { padding: 2.5rem 0 4rem; }
        article { max-width: 760px; }
        .breadcrumb { font-size: .85rem; color: var(--fg-dim); margin-bottom: 1.5rem; }
        .breadcrumb a { color: var(--fg-muted); }
        .breadcrumb span { margin: 0 .4rem; }
        article h1 { font-size: clamp(1.9rem, 4.5vw, 2.8rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.1; margin-bottom: 1rem; }
        .meta-row { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; align-items: center; font-size: .88rem; color: var(--fg-muted); padding-bottom: 1.25rem; border-bottom: 1px solid var(--border); margin-bottom: 1.75rem; }
        .meta-row time { color: var(--fg-dim); }
        .updated-banner { background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px; padding: .2rem .7rem; font-size: .8rem; }

        .answer { background: linear-gradient(120deg, color-mix(in srgb, var(--accent) 14%, transparent), color-mix(in srgb, var(--accent-3) 10%, transparent)); border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); border-radius: var(--radius-lg); padding: 1.25rem 1.5rem; font-size: 1.08rem; font-weight: 500; margin-bottom: 1.25rem; }
        .bluf { background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--accent-2); border-radius: 0 var(--radius) var(--radius) 0; padding: 1rem 1.25rem; color: var(--fg-muted); margin-bottom: 1.75rem; }
        .bluf strong, .answer strong { color: var(--fg); }
        .takeaways { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem 1.5rem; margin-bottom: 2rem; }
        .takeaways h2 { font-size: .82rem; text-transform: uppercase; letter-spacing: .1em; color: var(--accent); margin-bottom: .75rem; }
        .takeaways ul { padding-left: 1.1rem; display: grid; gap: .4rem; color: var(--fg-muted); font-size: .95rem; }

        .prose > * + * { margin-top: 1.1rem; }
        .prose h2 { font-size: 1.5rem; font-weight: 800; letter-spacing: -.02em; margin-top: 2.5rem; scroll-margin-top: 80px; }
        .prose h3 { font-size: 1.15rem; font-weight: 700; margin-top: 1.75rem; }
        .prose p { color: color-mix(in srgb, var(--fg) 92%, var(--fg-muted)); }
        .prose ul, .prose ol { padding-left: 1.3rem; color: var(--fg-muted); display: grid; gap: .4rem; }
        .prose strong { color: var(--fg); }
        .prose blockquote { border-left: 3px solid var(--accent); padding-left: 1rem; color: var(--fg-muted); font-style: italic; }
        .prose code { background: var(--surface-2); border: 1px solid var(--border); border-radius: 6px; padding: .1rem .35rem; font-size: .9em; }
        .prose table { width: 100%; border-collapse: collapse; font-size: .93rem; display: block; overflow-x: auto; }
        .prose th, .prose td { border: 1px solid var(--border); padding: .6rem .75rem; text-align: left; }
        .prose th { background: var(--surface-2); font-weight: 700; }
        .prose td { color: var(--fg-muted); }
        .prose img { border-radius: var(--radius); border: 1px solid var(--border); }

        .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-top: 2.5rem; }
        .panel h2 { font-size: .82rem; text-transform: uppercase; letter-spacing: .1em; color: var(--accent); margin-bottom: 1rem; }
        .stats { display: grid; gap: .6rem; }
        .stats div { display: flex; justify-content: space-between; gap: 1rem; font-size: .93rem; border-bottom: 1px dashed var(--border); padding-bottom: .5rem; }
        .stats b { color: var(--fg); }
        .stats span { color: var(--fg-dim); font-size: .82rem; text-align: right; }
        .faq dt { font-weight: 700; margin-top: 1rem; }
        .faq dd { color: var(--fg-muted); font-size: .95rem; margin: .25rem 0 0; }
        .citations { list-style: none; padding: 0; display: grid; gap: .6rem; }
        .citations li { font-size: .9rem; color: var(--fg-muted); }
        .citations cite { color: var(--fg-dim); }

        .app-badges { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
        .app-badge { display: inline-flex; align-items: center; gap: .6rem; padding: .55rem .85rem; border-radius: 10px; background: #000; color: #fff; font-size: .82rem; transition: transform var(--t); }
        .app-badge:hover { transform: scale(1.02); color: #fff; }
        .app-badge small { display: block; font-size: .65rem; opacity: .85; line-height: 1; }
        .app-badge strong { font-size: .85rem; font-weight: 500; }
        .app-badge-soon { cursor: default; }
        .app-badge-soon:hover { transform: none; color: #fff; }

        .share { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 2.5rem; align-items: center; }
        .share .lbl { font-size: .82rem; color: var(--fg-dim); margin-right: .25rem; }
        .share a { border: 1px solid var(--border); border-radius: 999px; padding: .35rem .8rem; font-size: .83rem; color: var(--fg-muted); }
        .share a:hover { border-color: var(--accent); color: var(--fg); }

        .byline { display: flex; gap: 1rem; align-items: flex-start; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
        .byline .avatar { width: 52px; height: 52px; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent-2)); display: grid; place-items: center; color: #fff; font-weight: 800; flex-shrink: 0; }
        .byline .who { font-weight: 700; }
        .byline .role, .byline .bio { font-size: .88rem; color: var(--fg-muted); }
        .byline .sameas { display: flex; gap: .75rem; font-size: .82rem; margin-top: .3rem; }
        .reviewed { margin-top: 1rem; font-size: .85rem; color: var(--fg-dim); border: 1px dashed var(--border); border-radius: var(--radius); padding: .7rem 1rem; }
        .reviewed b { color: var(--fg-muted); }

        .related { display: grid; gap: 1rem; margin-top: 2.5rem; }
        .related a { display: block; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; transition: border-color var(--t); }
        .related a:hover { border-color: var(--accent); }
        .related .t { font-weight: 700; }
        .related .d { font-size: .85rem; color: var(--fg-dim); }

        footer { padding: 2.5rem 0 2rem; border-top: 1px solid var(--border); color: var(--fg-muted); font-size: .9rem; }
        .foot { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; align-items: center; }
        .foot-links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
        .foot-links a { color: var(--fg-muted); }

        html[lang="es"] [lang="en"] { display: none !important; }
        html[lang="en"] [lang="es"] { display: none !important; }
        @media (prefers-reduced-motion: reduce) { * { transition-duration: .01ms !important; } }

/* ── listing pages (news index) ───────────────────────────── */
.list-head { padding: 3rem 0 1rem; }
.list-head h1 { font-size: clamp(1.9rem, 4.5vw, 2.8rem); font-weight: 800; letter-spacing: -.03em; margin-bottom: .75rem; }
.list-head .lede { color: var(--fg-muted); font-size: 1.05rem; max-width: 60ch; }
.eyebrow { display: inline-block; font-size: .78rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .75rem; }
.blog-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; padding: 1rem 0 4rem; }
@media (min-width: 680px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1000px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }
.blog-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; display: flex; flex-direction: column; gap: .75rem; transition: all var(--t); }
.blog-card:hover { border-color: var(--accent); transform: translateY(-2px); }
.blog-card .cat { font-size: .78rem; color: var(--fg-muted); text-transform: uppercase; letter-spacing: .1em; }
.blog-card h3 { font-size: 1.1rem; font-weight: 700; letter-spacing: -.01em; line-height: 1.3; }
.blog-card h3 a { color: var(--fg); }
.blog-card h3 a:hover { color: var(--accent); }
.blog-card .excerpt { color: var(--fg-muted); font-size: .92rem; flex: 1; }
.blog-card .date { color: var(--fg-dim); font-size: .82rem; }
.blog-card .read-more { color: var(--accent); font-weight: 600; font-size: .88rem; display: inline-flex; align-items: center; gap: .4rem; }
.blog-card .read-more:hover { color: var(--accent-2); gap: .6rem; }
.empty-state { background: var(--surface); border: 1px dashed var(--border); border-radius: var(--radius-lg); padding: 3rem; text-align: center; color: var(--fg-muted); margin-bottom: 4rem; }

/* ── translation notice (one file per language) ────────────────── */
.lang-notice { margin: 0 0 1.5rem; font-size: .9rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px; padding: .5rem 1rem; display: inline-block; color: var(--fg-muted); }
.lang-notice a { font-weight: 600; }
