<!doctype html>
<html lang="{{ lang or 'es' }}" data-theme="auto"
      {%- if alternates and alternates.es %} data-alt-es="{{ alternates.es }}"{% endif %}
      {%- if alternates and alternates.en %} data-alt-en="{{ alternates.en }}"{% endif %}>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="{{ site.themeDark }}" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="{{ site.themeLight }}" media="(prefers-color-scheme: light)" />

    {# ── SEO core ────────────────────────────────────────────── #}
    <title>{{ title }} · {{ site.name }}</title>
    <meta name="description" content="{{ description }}" />
    {% if tags %}<meta name="keywords" content="{{ tags | join(', ') }}" />{% endif %}
    <meta name="author" content="{{ site.name }}" />
    <meta name="robots" content="{{ robots }}" />
    <link rel="canonical" href="{{ canonical }}" />
    {% if alternates and alternates.es and alternates.en %}
    <link rel="alternate" hreflang="es" href="{{ alternates.es }}" />
    <link rel="alternate" hreflang="en" href="{{ alternates.en }}" />
    <link rel="alternate" hreflang="x-default" href="{{ xDefaultUrl or alternates.es }}" />
    {% endif %}
    {% if prev %}<link rel="prev" href="{{ prev.url }}" />{% endif %}
    {% if next %}<link rel="next" href="{{ next.url }}" />{% endif %}

    {# ── icons ───────────────────────────────────────────────── #}
    <link rel="icon" href="{{ site.favicon }}" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="{{ site.appleTouchIcon }}" />

    {# ── feeds & machine discovery (SEO / LLMO) ──────────────── #}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} — Noticias" href="{{ site.rss }}" />
    <link rel="alternate" type="application/feed+json" title="{{ site.name }} — Noticias" href="{{ site.jsonFeed }}" />
    <link rel="sitemap" type="application/xml" href="{{ site.sitemap }}" />
    <link rel="author" href="{{ site.llms }}" />

    {# ── identity / fediverse (social + E-E-A-T) ─────────────── #}
    {% if site.social.mastodon %}<link rel="me" href="{{ site.social.mastodon }}" />
    {% if fedServer %}<meta name="fed:server" content="{{ fedServer }}" />{% endif %}{% endif %}
    <meta name="linkedin:owner" content="{{ site.social.linkedin }}" />

    {# ── Open Graph ──────────────────────────────────────────── #}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="{{ site.social.siteName }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:image" content="{{ (image.src if image else '') | abs }}" />
    {% if image %}
    <meta property="og:image:width" content="{{ image.width }}" />
    <meta property="og:image:height" content="{{ image.height }}" />
    <meta property="og:image:alt" content="{{ image.alt }}" />
    <meta property="og:image:type" content="image/png" />
    {% else %}
    <meta property="og:image" content="{{ (site.ogImage) | abs }}" />
    {% endif %}
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:locale:alternate" content="{{ site.localeAlt }}" />
    <meta property="article:published_time" content="{{ pubDate | iso }}" />
    {% if updatedDate %}<meta property="article:modified_time" content="{{ updatedDate | iso }}" />{% endif %}
    {% if author %}<meta property="article:author" content="{{ author.url | abs }}" />{% endif %}
    {% if section %}<meta property="article:section" content="{{ section }}" />{% endif %}
    {% for tag in tags or [] %}<meta property="article:tag" content="{{ tag }}" />
    {% endfor %}
    {% if video %}
    <meta property="og:video" content="{{ video.src }}" />
    <meta property="og:video:secure_url" content="{{ video.src }}" />
    <meta property="og:video:type" content="video/mp4" />
    {% endif %}

    {# ── Twitter / X ─────────────────────────────────────────── #}
    <meta name="twitter:card" content="{{ 'summary' if not image else 'summary_large_image' }}" />
    <meta name="twitter:site" content="{{ site.social.twitter }}" />
    {% if site.social.twitterCreator %}<meta name="twitter:creator" content="{{ site.social.twitterCreator }}" />{% endif %}
    <meta name="twitter:title" content="{{ title | truncate(70) }}" />
    <meta name="twitter:description" content="{{ description | truncate(200) }}" />
    {% if image %}<meta name="twitter:image" content="{{ image.src | abs }}" />
    <meta name="twitter:image:alt" content="{{ image.alt }}" />
    {% else %}<meta name="twitter:image" content="{{ site.ogImage | abs }}" />{% endif %}
    {% if video %}
    <meta name="twitter:player" content="{{ video.src }}" />
    <meta name="twitter:player:stream" content="{{ video.src }}" />
    {% endif %}

    {# ── JSON-LD @graph (built in eleventyComputed.js) ───────── #}
    <script type="application/ld+json">{{ jsonld | safe }}</script>

    {% include "partials/theme-boot.njk" %}

    <style>
    {% include "partials/styles.njk" %}
    </style>
</head>
<body>
    <a class="skip" href="#main">
        <span lang="es">Saltar al contenido</span>
        <span lang="en">Skip to content</span>
    </a>

    {% include "partials/nav.njk" %}

    <main id="main">
        <div class="wrap">
            <article>
                {# ── breadcrumb (visible + mirrors JSON-LD #51) ───── #}
                <nav class="breadcrumb" aria-label="Breadcrumb">
                    <a href="/"><span lang="es">Inicio</span><span lang="en">Home</span></a><span>›</span>
                    <a href="{{ newsIndex }}"><span lang="es">Noticias</span><span lang="en">News</span></a><span>›</span>
                    {{ title }}
                </nav>

                <h1>{{ title }}</h1>

                {# ── dates / staleness (E-E-A-T) ──────────────────── #}
                <div class="meta-row">
                    {% if pubDate %}<time datetime="{{ pubDate | iso }}" itemprop="datePublished">
                        <span lang="es">Publicado el {{ pubDate | long(lang) }}</span>
                        <span lang="en">Published on {{ pubDate | long(lang) }}</span>
                    </time>{% endif %}
                    {% if updatedDate %}
                    <span class="updated-banner">
                        <span lang="es">✓ Actualizado el {{ updatedDate | long(lang) }}</span>
                        <span lang="en">✓ Updated on {{ updatedDate | long(lang) }}</span>
                    </span>
                    {% endif %}
                    {% set w = content | words %}
                    <span>{{ w | mins }}
                        <span lang="es">min de lectura</span>
                        <span lang="en">min read</span>
                    </span>
                    {% if section %}<span>{{ section }}</span>{% endif %}
                </div>

                {# ── translation notice: only when a real sibling exists ── #}
                {% if alternates and alternates.es and alternates.en %}
                <p class="lang-notice">
                    <span lang="es">Este artículo está también disponible en
                        <a href="{{ alternates.en }}" hreflang="en" rel="alternate">English →</a></span>
                    <span lang="en">This article is also available in
                        <a href="{{ alternates.es }}" hreflang="es" rel="alternate">Español →</a></span>
                </p>
                {% endif %}

                {# ── GEO/LLMO: answer-first block ─────────────────── #}
                {% if answer %}
                <p class="answer" itemprop="abstract"><strong>{{ answer }}</strong></p>
                {% endif %}
                {% if bluf %}
                <p class="bluf"><strong><span lang="es">En corto:</span><span lang="en">In short:</span></strong> {{ bluf }}</p>
                {% endif %}
                {% if keyTakeaways %}
                <section class="takeaways">
                    <h2><span lang="es">Ideas clave</span><span lang="en">Key takeaways</span></h2>
                    <ul>
                        {% for t in keyTakeaways %}<li>{{ t }}</li>{% endfor %}
                    </ul>
                </section>
                {% endif %}

                {# ── markdown body ─────────────────────────────────── #}
                <div class="prose" itemprop="articleBody">
                    {{ content | safe }}
                </div>

                {# ── sourced stats (GEO/E-E-A-T) ───────────────────── #}
                {% if stats %}
                <section class="panel">
                    <h2><span lang="es">Datos y cifras</span><span lang="en">Data &amp; figures</span></h2>
                    <div class="stats">
                        {% for s in stats %}
                        <div><b>{{ s.label }}: {{ s.value }}</b><span>{{ s.source }}</span></div>
                        {% endfor %}
                    </div>
                </section>
                {% endif %}

                {# ── FAQ, duplicated verbatim in JSON-LD ───────────── #}
                {% if faq %}
                <section class="panel" id="faq">
                    <h2><span lang="es">Preguntas frecuentes</span><span lang="en">Frequently asked questions</span></h2>
                    <dl class="faq">
                        {% for q in faq %}
                        <dt>{{ q.question }}</dt>
                        <dd>{{ q.answer }}</dd>
                        {% endfor %}
                    </dl>
                </section>
                {% endif %}

                {# ── citations / sources (GEO) ─────────────────────── #}
                {% if citations %}
                <section class="panel">
                    <h2><span lang="es">Fuentes</span><span lang="en">Sources</span></h2>
                    <ul class="citations">
                        {% for c in citations %}
                        <li>
                            <a href="{{ c.url }}" rel="external nofollow noopener" target="_blank">{{ c.title }}</a>
                            <cite>— {{ c.publisher }}{% if c.date %}, {{ c.date }}{% endif %}</cite>
                        </li>
                        {% endfor %}
                    </ul>
                </section>
                {% endif %}

                {# ── ASO: app badges ───────────────────────────────── #}
                {% if apps %}
                <div class="app-badges">
                    {% for app in apps %}
                    <a class="app-badge{% if not site.storeBase %} app-badge-soon{% endif %}"
                       {% if site.storeBase %}href="{{ site.storeBase }}{{ app.storeId or app.id }}"
                       rel="sponsored nofollow noopener" target="_blank"
                       aria-label="{{ app.name }} en Google Play"{% endif %}
                    >
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
                            <path d="M3.6 2.3c-.4.4-.6 1-.6 1.7v16c0 .7.2 1.3.6 1.7l.1.1L13 12 3.7 2.2l-.1.1zm10.4 10.4 2.6 2.6-9.5 5.4 6.9-8zm0-1.4L7.1 3.3l9.5 5.4-2.6 2.6zm6.2-1.4-2.5-1.4-3 3 3 3 2.5-1.4c1-.6 1-2.2 0-2.8z"/>
                        </svg>
                        <span><small>
                            {% if site.storeBase %}<span lang="es">Descargar en</span><span lang="en">Get it on</span>{% else %}<span lang="es">Próximamente en</span><span lang="en">Coming soon to</span>{% endif %}
                        </small><strong>{{ app.name }}</strong></span>
                    </a>
                    {% endfor %}
                </div>
                {% endif %}

                {# ── share buttons (built from canonical) ──────────── #}
                {% set u = canonical | urlencode %}
                {% set t = title | urlencode %}
                <div class="share" role="group" aria-label="Compartir">
                    <span class="lbl"><span lang="es">Compartir:</span><span lang="en">Share:</span></span>
                    {% for s in site.share %}
                    <a href="{{ s.url | replace('{u}', u) | replace('{t}', t) }}" rel="noopener nofollow" target="_blank">{{ s.name }}</a>
                    {% endfor %}
                </div>

                {# ── E-E-A-T: byline + reviewer ────────────────────── #}
                {% if author %}
                <div class="byline" rel="author">
                    <div class="avatar" aria-hidden="true">{{ author.name[0] }}</div>
                    <div>
                        <div class="who">{{ author.name }}{% if author.role %} · <span class="role">{{ author.role }}</span>{% endif %}</div>
                        {% if author.bio %}<div class="bio">{{ author.bio }}</div>{% endif %}
                        {% if author.sameAs %}
                        <div class="sameas">
                            {% for s in author.sameAs %}<a href="{{ s }}" rel="me noopener" target="_blank">{{ s | replace('https://', '') | replace('http://', '') | truncate(28, true, '') }}</a>{% endfor %}
                        </div>
                        {% endif %}
                    </div>
                </div>
                {% endif %}
                {% if reviewer %}
                <div class="reviewed">
                    <b><span lang="es">Revisado por:</span><span lang="en">Reviewed by:</span></b>
                    {{ reviewer.name }} — {{ reviewer.role }}
                    {% if reviewer.credentials %} ({{ reviewer.credentials }}){% endif %}
                    {% if reviewedDate %} · <time datetime="{{ reviewedDate | iso }}">{{ reviewedDate | long(lang) }}</time>{% endif %}
                </div>
                {% endif %}

                {# ── related articles, same language ──────────────── #}
                {% set pool = collections.newsEn if lang == 'en' else collections.newsEs %}
                {% set rel = pool | others(page.fileSlug) %}
                {% if rel.length %}
                <section class="related" aria-label="Artículos relacionados">
                    {% for p in rel.slice(0, 3) %}
                    <a href="{{ p.url }}">
                        <div class="t">{{ p.data.title }}</div>
                        <div class="d">{{ p.data.description }}</div>
                    </a>
                    {% endfor %}
                </section>
                {% endif %}
            </article>
        </div>
    </main>

    {% include "partials/footer.njk" %}

    {% include "partials/toggles.njk" %}
</body>
</html>
